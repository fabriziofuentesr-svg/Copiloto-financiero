# Vite expone al navegador únicamente variables con prefijo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173

# Mantén local durante desarrollo sin credenciales. En producción usa supabase.
VITE_DATA_MODE=supabase

# Nunca añadas SUPABASE_SERVICE_ROLE_KEY a una variable VITE_*.
# Si se necesita en el futuro, debe existir solo en un entorno de servidor seguro.

